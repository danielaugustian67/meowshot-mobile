# Base URL of the Meowshot API (with /v1). Defaults to production when unset.
# For a local backend on the same Mac (iOS simulator / web): http://localhost:8080/v1
# For a real phone or the Android emulator use the laptop's LAN IP, e.g. http://192.168.1.10:8080/v1
EXPO_PUBLIC_API_URL=https://meowshot-api.zyros.me/v1

# Google Sign-In client IDs (defaults to production when unset). The web ID is the id_token audience
# and must be in the server's GOOGLE_CLIENT_IDS. The iOS ID must match iosUrlScheme in app.json.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=554006493413-iaesh43ucl55hot3nh7mhm382gsoac2h.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=554006493413-hudoaj15acn03p7c538dnj4b4evqljec.apps.googleusercontent.com
