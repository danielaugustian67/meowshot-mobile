# Base URL of the Meowshot API (with /v1). Defaults to production when unset.
# For a local backend on the same Mac (iOS simulator / web): http://localhost:8080/v1
# For a real phone or the Android emulator use the laptop's LAN IP, e.g. http://192.168.1.10:8080/v1
EXPO_PUBLIC_API_URL=https://meowshot-api.zyros.me/v1
